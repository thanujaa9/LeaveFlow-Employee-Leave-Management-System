          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leaves/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "1", "cancel"]
            }
          }
        },
        {
          "name": "Get Team Calendar Leaves",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leaves/calendar?year=2026&month=11",
              "host": ["{{baseUrl}}"],
              "path": ["leaves", "calendar"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "11" }
              ]
            }
          }
        }
      ]
    },
